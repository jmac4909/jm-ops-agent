# JM Ops Agent does not load .env files automatically. Copy the settings you need
# into Windows environment variables, an IDE launch configuration, or an approved
# external Spring configuration file. Never put real credentials in this file.

# Profile and local HTTP port
SPRING_PROFILES_ACTIVE=local-live
SPRING_CONFIG_ADDITIONAL_LOCATION=
JM_OPS_BIND_ADDRESS=127.0.0.1
JM_OPS_PORT=8080

# External live service registry. Keep real service/controller/index mappings out of Git.
# Example: file:C:/Users/<user>/AppData/Local/jm-ops-agent/service-registry.yml
JMOPS_SERVICE_REGISTRY_LOCATION=classpath:service-registry.yml

# Claude Code CLI (uses the developer's existing corporate authentication)
CLAUDE_ENABLED=true
CLAUDE_EXECUTABLE=claude
CLAUDE_TIMEOUT=2m
CLAUDE_MODEL=
JMOPS_CLAUDE_STRUCTURED_OUTPUT_MODE=AUTO
JMOPS_CLAUDE_MAX_TURNS_PER_INVOCATION=1

# Kubernetes: context is required; namespaces below are fallbacks when not in the registry
KUBECTL_EXECUTABLE=kubectl
KUBERNETES_DEV_CONTEXT=
KUBERNETES_DEV_NAMESPACE=
KUBERNETES_TEST_CONTEXT=
KUBERNETES_TEST_NAMESPACE=

# Tanzu Application Service: CF CLI must already be authenticated
CF_EXECUTABLE=cf
CF_DEV_API=
CF_DEV_ORG=
CF_DEV_SPACE=
CF_DEV_HOME=
CF_TEST_API=
CF_TEST_ORG=
CF_TEST_SPACE=
CF_TEST_HOME=
# For multiple CF targets in one environment, reference separately named variables such as
# CF_GROUP_ONE_TEST_API/ORG/SPACE/HOME from an ignored application-local.yml target map.
CF_GROUP_ONE_DEV_API=
CF_GROUP_ONE_DEV_ORG=
CF_GROUP_ONE_DEV_SPACE=
CF_GROUP_ONE_DEV_HOME=
CF_GROUP_ONE_TEST_API=
CF_GROUP_ONE_TEST_ORG=
CF_GROUP_ONE_TEST_SPACE=
CF_GROUP_ONE_TEST_HOME=
CF_GROUP_TWO_TEST_API=
CF_GROUP_TWO_TEST_ORG=
CF_GROUP_TWO_TEST_SPACE=
CF_GROUP_TWO_TEST_HOME=
JMOPS_TAS_APP_PATTERN={service}-{environment}
JMOPS_TAS_ENVIRONMENT_METADATA_ENABLED=false

# Jenkins REST API. These legacy variables support one controller. For multiple
# controllers, use an ignored application-local.yml as documented in docs/live-connectors.md.
JENKINS_BASE_URL=
JENKINS_USERNAME=
JENKINS_TOKEN=
# Example environment references for the ignored multi-controller YAML configuration.
JENKINS_PRIMARY_BASE_URL=
JENKINS_PRIMARY_USERNAME=
JENKINS_PRIMARY_TOKEN=
JENKINS_SECONDARY_BASE_URL=
JENKINS_SECONDARY_USERNAME=
JENKINS_SECONDARY_TOKEN=
JMOPS_INTEGRATIONS_JENKINS_JOB_PATTERN={service}-{environment}-deploy

# GitLab REST API
GITLAB_BASE_URL=
GITLAB_TOKEN=

# Splunk REST API. BEARER_TOKEN is preferred. SESSION_KEY uses the legacy
# Authorization: Splunk scheme. SESSION_CSRF is a compatibility mode that requires
# the complete cookie header and matching form key; never save either here.
SPLUNK_BASE_URL=
SPLUNK_AUTH_MODE=BEARER_TOKEN
SPLUNK_TOKEN=
SPLUNK_SESSION_COOKIE=
SPLUNK_FORM_KEY=
SPLUNK_DEV_INDEXES=
SPLUNK_TEST_INDEXES=
SPLUNK_DEV_GATEWAY_INDEXES=
SPLUNK_TEST_GATEWAY_INDEXES=
SPLUNK_REQUEST_TIMEOUT=45s

# Optional executable shown by startup diagnostics
JMOPS_GIT_EXECUTABLE=git

# Safety and investigation budgets (defaults shown)
JMOPS_SANITIZATION_INCLUDE_BODIES=false
JMOPS_LIMITS_MAX_CLAUDE_ITERATIONS=3
JMOPS_LIMITS_MAX_WALL_CLOCK=2m
JMOPS_LIMITS_MAX_EVIDENCE_ITEMS=50
JMOPS_LIMITS_MAX_LOG_EVENTS=200
JMOPS_LIMITS_MAX_SPLUNK_SEARCHES=5
JMOPS_LIMITS_MAX_CODE_FILES=8
JMOPS_LIMITS_MAX_HISTORICAL_INCIDENTS=5
JMOPS_LIMITS_MAX_FOLLOW_UPS=10
JMOPS_LIMITS_TRACKING_SEARCH_WINDOW=72h
